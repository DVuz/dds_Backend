# Server
NODE_ENV=production
PORT=3000
BASE_URL=https://your-app.koyeb.app
FRONTEND_URL=https://your-frontend.com
PUBLIC_URL=https://your-public-url.com
USE_PUBLIC_URL=true

# Database (Aiven MySQL)
DB_HOST=your-db-host.aivencloud.com
DB_PORT=12128
DB_DATABASE=your_database
DB_USERNAME=your_username
DB_PASSWORD=your_secure_password

# JWT Secrets (CHANGE THESE!)
JWT_SECRET=your_strong_jwt_secret_minimum_32_characters
JWT_REFRESH_SECRET=your_strong_refresh_secret_minimum_32_characters

# Token Expiration
ACCESS_TOKEN_EXPIRY=3d
REFRESH_TOKEN_EXPIRY=14d

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your_app_specific_password

# Cloudinary
CLOUDINARY_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis
REDIS_USERNAME=default
REDIS_PORT=13099
REDIS_PASSWORD=your_redis_password
REDIS_HOST=your-redis-host.redis-cloud.com

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS (Optional)
CORS_ORIGIN=*
